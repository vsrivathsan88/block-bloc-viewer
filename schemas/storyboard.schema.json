{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsrivathsan88.github.io/block-bloc-viewer/schemas/storyboard.schema.json",
  "title": "Shotboard project export",
  "description": "Self-contained storyboard project (images inlined as data URLs). Produced/consumed by the /storyboard app's export & import.",
  "type": "object",
  "required": [
    "format",
    "version",
    "project",
    "images"
  ],
  "properties": {
    "format": {
      "const": "shotboard-project"
    },
    "version": {
      "const": 1
    },
    "images": {
      "type": "object",
      "description": "imageId \u2192 data URL (image/jpeg)",
      "additionalProperties": {
        "type": "string",
        "pattern": "^data:image/"
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "title",
        "world",
        "frames",
        "scenes",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        },
        "world": {
          "type": "object",
          "required": [
            "spzUrl",
            "title"
          ],
          "properties": {
            "kind": {
              "enum": ["splat", "image"],
              "description": "what the project shoots in: a Marble splat world (default) or a single reference image (FARM AR single-image rig)"
            },
            "spzUrl": {
              "type": "string",
              "description": "splat URL; empty string for image worlds"
            },
            "imageId": {
              "type": "string",
              "description": "images-store key of the reference image (image worlds)"
            },
            "refFrameId": {
              "type": "string",
              "description": "the reference CapturedFrame every shot starts from (image worlds)"
            },
            "colliderUrl": {
              "type": "string",
              "format": "uri"
            },
            "title": {
              "type": "string"
            },
            "worldId": {
              "type": "string",
              "description": "Marble world id; fields re-resolvable via GET /marble/v1/worlds/{id}"
            },
            "caption": {
              "type": "string",
              "description": "generated_recaption/world_prompt \u2014 grounds FARM prompts"
            },
            "minimapUrl": {
              "type": "string",
              "format": "uri"
            },
            "spzUrls": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "splat tiers for LOD switching"
            }
          }
        },
        "frames": {
          "type": "array",
          "description": "Posed frame library \u2014 every capture keeps its camera pose (a FARM AR spatial anchor).",
          "items": {
            "$ref": "#/$defs/capturedFrame"
          }
        },
        "cast": {
          "type": "array",
          "description": "Characters; reference images keep them consistent across shots' cast passes.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "description",
              "refImageIds"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "refImageIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "enum": [
                  "character",
                  "prop"
                ],
                "description": "default character"
              }
            }
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "number",
              "heading",
              "shots"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "number": {
                "type": "integer"
              },
              "heading": {
                "type": "string"
              },
              "shots": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/shot"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quat": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "XYZW quaternion, Three.js convention"
    },
    "pose": {
      "type": "object",
      "required": [
        "position",
        "quaternion"
      ],
      "description": "Camera-to-world transform in the splat-world frame (Three.js: Y-up, Z-backward)",
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "quaternion": {
          "$ref": "#/$defs/quat"
        }
      }
    },
    "capturedFrame": {
      "type": "object",
      "required": [
        "id",
        "imageId",
        "pose",
        "fov",
        "aspect",
        "label",
        "capturedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "imageId": {
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/pose"
        },
        "fov": {
          "type": "number",
          "description": "vertical fov, degrees"
        },
        "aspect": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "capturedAt": {
          "type": "number"
        }
      }
    },
    "shot": {
      "type": "object",
      "required": [
        "id",
        "number",
        "contextFrameIds",
        "lensMm",
        "angle",
        "movement",
        "durationSec",
        "action",
        "dialogue",
        "notes",
        "strokes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "frameId": {
          "type": "string",
          "description": "keyframe (marked IN) \u2014 id into project.frames; the clean plate"
        },
        "castFrameId": {
          "type": "string",
          "description": "cast plate (characters composited in); inherits the clean plate's pose and replaces it as the identity anchor"
        },
        "endPose": {
          "$ref": "#/$defs/pose"
        },
        "contextFrameIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ordered FARM AR context anchors (frame ids). The first anchor becomes the identity pose of the generation."
        },
        "lensMm": {
          "type": "number"
        },
        "angle": {
          "enum": [
            "eye-level",
            "low",
            "high",
            "overhead",
            "dutch",
            "pov"
          ]
        },
        "movement": {
          "enum": [
            "static",
            "push-in",
            "pull-out",
            "pan-left",
            "pan-right",
            "tilt-up",
            "tilt-down",
            "track-left",
            "track-right",
            "crane-up",
            "crane-down",
            "dolly-zoom",
            "whip-pan",
            "handheld"
          ]
        },
        "durationSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "action": {
          "type": "string"
        },
        "dialogue": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "strokes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tool",
              "color",
              "width",
              "points"
            ],
            "properties": {
              "tool": {
                "enum": [
                  "pencil",
                  "arrow"
                ]
              },
              "color": {
                "type": "string"
              },
              "width": {
                "type": "number"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": "normalized 0..1 panel coordinates"
              }
            }
          }
        },
        "farm": {
          "type": "object",
          "required": [
            "taskId",
            "status",
            "prompt",
            "contextFrameIds",
            "frameCount",
            "submittedAt"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "status": {
              "enum": [
                "queued",
                "running",
                "done",
                "error"
              ]
            },
            "prompt": {
              "type": "string"
            },
            "contextFrameIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "frameCount": {
              "type": "integer"
            },
            "videoUrl": {
              "type": "string"
            },
            "error": {
              "type": "string"
            },
            "submittedAt": {
              "type": "number"
            },
            "mock": {
              "type": "boolean"
            }
          }
        },
        "pathPoses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pose"
          },
          "description": "recorded camera path waypoints; overrides movement/endPose \u2014 targets sample the arc-length spline through these"
        },
        "takes": {
          "type": "array",
          "description": "every completed generation, oldest first; the circled take is the keeper the board and animatic play",
          "items": {
            "type": "object",
            "required": ["id", "prompt", "seedOffset", "generatedAt"],
            "properties": {
              "id": { "type": "string" },
              "videoUrl": { "type": "string", "description": "remote MP4 (live FARM)" },
              "videoId": { "type": "string", "description": "images-store key for locally rendered footage (mock mode)" },
              "prompt": { "type": "string" },
              "seedOffset": { "type": "integer" },
              "generatedAt": { "type": "number" },
              "circled": { "type": "boolean" },
              "rejected": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
